<Window x:Class="DesktopTuner.StartMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DesktopTuner"
        Title="Desktop Tuner Start" Width="470" Height="650" MinWidth="340" MinHeight="440"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource DesktopSurfaceAltBrush}" Foreground="{DynamicResource DesktopPrimaryTextBrush}" FontFamily="Segoe UI Variable Text, Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown" Loaded="Window_Loaded">
    <Window.Resources>
        <ItemsPanelTemplate x:Key="PinnedStartHorizontalPanel"><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="PinnedStartGroupsPanel"><StackPanel Orientation="Vertical" /></ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="Windows8TilePanel"><WrapPanel /></ItemsPanelTemplate>
        <Style x:Key="StartRecentIcon" TargetType="Image">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type local:StartMenuWindow}}}" Value="Small"><Setter Property="Width" Value="16" /><Setter Property="Height" Value="16" /></DataTrigger>
                <DataTrigger Binding="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type local:StartMenuWindow}}}" Value="Large"><Setter Property="Width" Value="24" /><Setter Property="Height" Value="24" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StartSearchIconHost" TargetType="Grid">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type local:StartMenuWindow}}}" Value="Small"><Setter Property="Width" Value="24" /><Setter Property="Height" Value="24" /></DataTrigger>
                <DataTrigger Binding="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type local:StartMenuWindow}}}" Value="Large"><Setter Property="Width" Value="38" /><Setter Property="Height" Value="38" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StartSearchIcon" TargetType="Image">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type local:StartMenuWindow}}}" Value="Small"><Setter Property="Width" Value="22" /><Setter Property="Height" Value="22" /></DataTrigger>
                <DataTrigger Binding="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type local:StartMenuWindow}}}" Value="Large"><Setter Property="Width" Value="36" /><Setter Property="Height" Value="36" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StartFlyoutIconHost" TargetType="Grid">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type local:StartMenuWindow}}}" Value="Small"><Setter Property="Width" Value="20" /><Setter Property="Height" Value="20" /></DataTrigger>
                <DataTrigger Binding="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type local:StartMenuWindow}}}" Value="Large"><Setter Property="Width" Value="32" /><Setter Property="Height" Value="32" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StartFlyoutIcon" TargetType="Image">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type local:StartMenuWindow}}}" Value="Small"><Setter Property="Width" Value="18" /><Setter Property="Height" Value="18" /></DataTrigger>
                <DataTrigger Binding="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type local:StartMenuWindow}}}" Value="Large"><Setter Property="Width" Value="30" /><Setter Property="Height" Value="30" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource DesktopSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DesktopPrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DesktopBorderBrush}" />
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource DesktopSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DesktopPrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DesktopBorderBrush}" />
            <Setter Property="local:AcrylicContextMenuBehavior.IsEnabled" Value="True" />
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource DesktopPrimaryTextBrush}" />
            <Setter Property="Padding" Value="{DynamicResource TouchMenuItemPadding}" />
            <Setter Property="MinHeight" Value="{DynamicResource TouchMenuItemMinimumHeight}" />
        </Style>
    </Window.Resources>
    <Border x:Name="OuterBorder" Background="{DynamicResource DesktopSurfaceAltBrush}" BorderBrush="{DynamicResource DesktopBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="20">
        <Grid x:Name="MenuLayout">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel x:Name="HeaderPanel" Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,18">
                <Button Width="38" Height="38" Margin="0,0,11,0" Padding="0" Background="Transparent" BorderThickness="0" Click="ProfileButton_Click" ToolTip="Open account settings; right-click for account actions" AutomationProperties.Name="Account settings">
                    <Grid>
                        <Ellipse x:Name="ProfileAvatar" Fill="#6258D9" />
                        <TextBlock x:Name="ProfileInitials" Text="U" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Account settings" Click="ProfileButton_Click" />
                            <Separator />
                            <MenuItem Header="Lock" Tag="lock" Click="PowerAction_Click" />
                            <MenuItem Header="Sign out" Tag="sign-out" Click="PowerAction_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTitle" Text="Good to see you" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock x:Name="HeaderSubtitle" Text="Search apps or open a favorite place" FontSize="11" Foreground="{DynamicResource DesktopMutedTextBrush}" Margin="0,2,0,0" />
                </StackPanel>
                <Button Content="×" Width="30" Height="30" HorizontalAlignment="Right" Margin="12,0,0,0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource DesktopMutedTextBrush}" FontSize="18" Click="Close_Click" />
            </StackPanel>
            <TextBox x:Name="SearchBox" Grid.Row="1" Height="46" FontSize="14" Padding="14,9" BorderBrush="{DynamicResource DesktopInputBorderBrush}" Background="{DynamicResource DesktopSurfaceBrush}" Foreground="{DynamicResource DesktopPrimaryTextBrush}" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" ToolTip="Search installed Start menu apps" />
            <Grid x:Name="AppPanel" Grid.Row="2" Margin="0,16,0,10">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel x:Name="AppPanelHeading" Grid.Row="0" Margin="2,0,2,9">
                    <TextBlock x:Name="ResultsHeading" Text="All apps" FontWeight="SemiBold" FontSize="13" />
                    <StackPanel x:Name="SearchActionPanel" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock x:Name="ResultCount" Foreground="{DynamicResource DesktopFaintTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <Button Content="Windows" Click="WindowsSearch_Click" Padding="7,4" Margin="0,0,4,0" Background="{DynamicResource DesktopSurfaceBrush}" BorderBrush="{DynamicResource DesktopBorderBrush}" FontSize="10" ToolTip="Search Windows and indexed files" />
                        <Button Content="Web" Click="WebSearch_Click" Padding="7,4" Background="{DynamicResource DesktopSurfaceBrush}" BorderBrush="{DynamicResource DesktopBorderBrush}" FontSize="10" ToolTip="Search the web in your default browser" />
                    </StackPanel>
                </DockPanel>
                <StackPanel x:Name="PinnedStartPanel" Grid.Row="1" Visibility="Collapsed" Margin="0,0,0,8" AllowDrop="True" DragOver="PinnedStartPanel_DragOver" Drop="PinnedStartPanel_Drop">
                    <TextBlock Text="Pinned" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DesktopMutedTextBrush}" Margin="4,0,0,3" />
                    <TextBlock x:Name="PinnedStartEmptyHint" Text="Drag apps here to pin them" FontSize="10" Foreground="{DynamicResource DesktopFaintTextBrush}" Margin="4,2,0,4" Visibility="Collapsed" />
                    <ScrollViewer x:Name="PinnedStartScrollViewer" Height="82" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="PinnedStartItems" AlternationCount="4" ItemsPanel="{StaticResource PinnedStartHorizontalPanel}">
                            <ItemsControl.GroupStyle>
                                <GroupStyle Panel="{StaticResource Windows8TilePanel}">
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" Tag="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource DesktopMutedTextBrush}" Margin="4,7,0,5" AllowDrop="True" DragOver="PinnedStartGroup_DragOver" Drop="PinnedStartGroup_Drop" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding}" Click="PinnedStartApp_Click" PreviewMouseLeftButtonDown="PinnedStartApp_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="PinnedStartApp_PreviewMouseLeftButtonUp" PreviewMouseMove="PinnedStartApp_PreviewMouseMove" AllowDrop="True" DragOver="PinnedStartApp_DragOver" Drop="PinnedStartApp_Drop" ToolTip="{Binding Name}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="{DynamicResource DesktopSurfaceBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource DesktopPrimaryTextBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource DesktopBorderBrush}" />
                                                <Setter Property="Width" Value="76" />
                                                <Setter Property="Height" Value="76" />
                                                <Setter Property="Margin" Value="2,0,3,0" />
                                                <Setter Property="Padding" Value="3" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Tag}" Value="{x:Static local:StartMenuStyle.Windows8}">
                                                        <Setter Property="Width" Value="136" />
                                                        <Setter Property="Height" Value="96" />
                                                        <Setter Property="Margin" Value="4" />
                                                        <Setter Property="Padding" Value="10" />
                                                        <Setter Property="BorderThickness" Value="0" />
                                                        <Setter Property="Foreground" Value="White" />
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Tag}" Value="{x:Static local:StartMenuStyle.Windows8}" />
                                                            <Condition Binding="{Binding TileSize}" Value="{x:Static local:StartTileSize.Small}" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Width" Value="64" />
                                                        <Setter Property="Height" Value="64" />
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Tag}" Value="{x:Static local:StartMenuStyle.Windows8}" />
                                                            <Condition Binding="{Binding TileSize}" Value="{x:Static local:StartTileSize.Wide}" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Width" Value="280" />
                                                        <Setter Property="Height" Value="96" />
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Tag}" Value="{x:Static local:StartMenuStyle.Windows8}" />
                                                            <Condition Binding="{Binding TileSize}" Value="{x:Static local:StartTileSize.Large}" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Width" Value="280" />
                                                        <Setter Property="Height" Value="200" />
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Tag}" Value="{x:Static local:StartMenuStyle.Windows8}" />
                                                            <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}" Value="0" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Background" Value="{DynamicResource DesktopTileBlueBrush}" />
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Tag}" Value="{x:Static local:StartMenuStyle.Windows8}" />
                                                            <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}" Value="1" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Background" Value="{DynamicResource DesktopTileGreenBrush}" />
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Tag}" Value="{x:Static local:StartMenuStyle.Windows8}" />
                                                            <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}" Value="2" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Background" Value="{DynamicResource DesktopTileOrangeBrush}" />
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Tag}" Value="{x:Static local:StartMenuStyle.Windows8}" />
                                                            <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}" Value="3" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Background" Value="{DynamicResource DesktopTilePurpleBrush}" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Button.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}" Opened="PinnedStartContextMenu_Opened">
                                                <MenuItem Header="Open folder" Tag="{Binding}" Click="OpenPinnedFolder_Click" />
                                                <MenuItem Header="Open file location" Tag="{Binding}" IsEnabled="{Binding CanOpenFileLocation}" Click="OpenFileLocation_Click" />
                                                <MenuItem Header="Pin to taskbar" Tag="{Binding}" IsEnabled="{Binding CanPinToTaskbar}" Click="PinTaskbarItem_Click" />
                                                <Separator />
                                                <MenuItem Header="Run as administrator" Tag="{Binding}" IsEnabled="{Binding CanRunElevated}" Click="RunAsAdministrator_Click" />
                                                <Separator />
                                                <MenuItem Header="Move earlier" Tag="{Binding}" Click="MoveStartAppEarlier_Click" />
                                                <MenuItem Header="Move later" Tag="{Binding}" Click="MoveStartAppLater_Click" />
                                                <Separator />
                                                <MenuItem Header="Tile size" Tag="{Binding}">
                                                    <MenuItem Header="Small" Tag="{x:Static local:StartTileSize.Small}" IsCheckable="True" Click="PinnedStartTileSize_Click" />
                                                    <MenuItem Header="Medium" Tag="{x:Static local:StartTileSize.Medium}" IsCheckable="True" Click="PinnedStartTileSize_Click" />
                                                    <MenuItem Header="Wide" Tag="{x:Static local:StartTileSize.Wide}" IsCheckable="True" Click="PinnedStartTileSize_Click" />
                                                    <MenuItem Header="Large" Tag="{x:Static local:StartTileSize.Large}" IsCheckable="True" Click="PinnedStartTileSize_Click" />
                                                </MenuItem>
                                                <Separator />
                                                <MenuItem Header="Move to group" Tag="{Binding}" SubmenuOpened="PinnedStartGroupMenu_Opened" />
                                                <MenuItem Header="Create group and move…" Tag="{Binding}" Click="CreateStartGroup_Click" />
                                                <MenuItem Header="Rename this group…" Tag="{Binding}" Click="RenameStartGroup_Click" />
                                                <Separator />
                                                <MenuItem Header="Unpin from Start" Tag="{Binding}" Click="UnpinStartApp_Click" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <StackPanel x:Name="PinnedStartTileContent" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Orientation" Value="Vertical" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Tag}" Value="{x:Static local:StartMenuStyle.Windows8}"><Setter Property="Orientation" Value="Horizontal" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Grid x:Name="PinnedStartTileIcon" HorizontalAlignment="Center">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Width" Value="34" />
                                                        <Setter Property="Height" Value="34" />
                                                        <Style.Triggers><DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Tag}" Value="{x:Static local:StartMenuStyle.Windows8}"><Setter Property="Width" Value="42" /><Setter Property="Height" Value="42" /></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Image Source="{Binding Icon}">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Width" Value="32" />
                                                            <Setter Property="Height" Value="32" />
                                                            <Style.Triggers><DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Tag}" Value="{x:Static local:StartMenuStyle.Windows8}"><Setter Property="Width" Value="40" /><Setter Property="Height" Value="40" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                                <Border CornerRadius="8" Background="{DynamicResource DesktopAccentTintBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Name}" MaxWidth="30" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource DesktopAccentTextBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" MaxHeight="36">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource DesktopPrimaryTextBrush}" />
                                                        <Setter Property="FontSize" Value="9" />
                                                        <Setter Property="Margin" Value="0,3,0,0" />
                                                        <Setter Property="TextAlignment" Value="Center" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Tag}" Value="{x:Static local:StartMenuStyle.Windows8}">
                                                                <Setter Property="Foreground" Value="White" />
                                                                <Setter Property="FontSize" Value="11" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                <Setter Property="TextAlignment" Value="Left" />
                                                                <Setter Property="Margin" Value="10,0,0,0" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
                <StackPanel x:Name="RecentStartPanel" Grid.Row="2" Margin="0,0,0,8" Visibility="Collapsed">
                    <DockPanel Margin="3,0,3,4">
                        <TextBlock Text="Recently used" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DesktopMutedTextBrush}" VerticalAlignment="Center" />
                        <Button Content="Clear app history" DockPanel.Dock="Right" Click="ClearRecentStartApps_Click" Padding="5,2" FontSize="10" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource DesktopMutedTextBrush}" ToolTip="Clear Desktop Tuner's recently used app history" />
                    </DockPanel>
                    <ScrollViewer Height="42" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="RecentStartItems">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding}" Click="RecentStartApp_Click" Width="126" Height="36" Margin="2,0,4,0" Padding="6,3" HorizontalContentAlignment="Left" ToolTip="{Binding Name}">
                                        <Button.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}" Opened="RecentStartContextMenu_Opened">
                                                <MenuItem Header="Open file location" Tag="{Binding}" Click="OpenFileLocation_Click" />
                                                <MenuItem Header="Open with…" Tag="{Binding}" Visibility="Collapsed" Click="OpenWithRecentItem_Click" />
                                                <MenuItem Header="Print" Tag="{Binding}" Visibility="Collapsed" Click="PrintRecentItem_Click" />
                                                <MenuItem Header="Pin to Start" Tag="{Binding}" Click="PinStartApp_Click" />
                                                <MenuItem Header="Pin to taskbar" Tag="{Binding}" Click="PinTaskbarItem_Click" />
                                                <MenuItem Header="Run as administrator" Tag="{Binding}" Click="RunAsAdministrator_Click" />
                                                <MenuItem Header="Remove from recent list" Tag="{Binding}" Click="RemoveRecentItem_Click" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding Icon}" Style="{StaticResource StartRecentIcon}" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Name}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
                <ListBox x:Name="AppList" Grid.Row="3" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto" MouseDoubleClick="AppList_MouseDoubleClick" PreviewMouseLeftButtonDown="AppList_PreviewMouseLeftButtonDown" PreviewMouseMove="AppList_PreviewMouseMove">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="11,10" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource DesktopHoverBrush}" /></Trigger>
                                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource DesktopSelectedBrush}" /></Trigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Tag}" Value="{x:Static local:StartMenuStyle.Windows7}">
                                                <Setter TargetName="Row" Property="CornerRadius" Value="2" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Tag}" Value="{x:Static local:StartMenuStyle.Windows7}">
                                    <Setter Property="Padding" Value="7,5" />
                                    <Setter Property="Margin" Value="0,1" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Pin to Start" Tag="{Binding Application}" Click="PinStartApp_Click" />
                                        <MenuItem Header="Pin to taskbar" Tag="{Binding Application}" IsEnabled="{Binding Application.CanPinToTaskbar}" Click="PinTaskbarItem_Click" />
                                        <MenuItem Header="Open file location" Tag="{Binding Application}" IsEnabled="{Binding Application.CanOpenFileLocation}" Click="OpenFileLocation_Click" />
                                        <MenuItem Header="Run as administrator" Tag="{Binding Application}" IsEnabled="{Binding Application.CanRunElevated}" Click="RunAsAdministrator_Click" />
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding AlphabetMarker}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource DesktopAccentTextBrush}" Margin="0,0,0,4">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers><DataTrigger Binding="{Binding AlphabetMarker}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Grid Grid.Row="1" Style="{StaticResource StartSearchIconHost}" VerticalAlignment="Center">
                                    <Image Source="{Binding Application.Icon}" Style="{StaticResource StartSearchIcon}" />
                                    <Border CornerRadius="8" Background="{DynamicResource DesktopAccentTintBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers><DataTrigger Binding="{Binding Application.Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Application.Name}" MaxWidth="35" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource DesktopAccentTextBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Application.Name}" FontSize="13" FontWeight="Medium" />
                                    <TextBlock Text="{Binding Application.SourceDescription}" FontSize="10" Foreground="{DynamicResource DesktopFaintTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TreeView x:Name="AppTree" Grid.Row="2" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto" MouseDoubleClick="AppTree_MouseDoubleClick" PreviewMouseLeftButtonDown="AppTree_PreviewMouseLeftButtonDown" PreviewMouseMove="AppTree_PreviewMouseMove">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type local:StartMenuNode}" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Pin to Start" Tag="{Binding Application}" IsEnabled="{Binding CanPinApplication}" Click="PinStartApp_Click" />
                                        <MenuItem Header="Pin to taskbar" Tag="{Binding Application}" IsEnabled="{Binding CanPinApplicationToTaskbar}" Click="PinTaskbarItem_Click" />
                                        <Separator />
                                        <MenuItem Header="Open file location" Tag="{Binding Application}" IsEnabled="{Binding CanOpenApplicationFileLocation}" Click="OpenFileLocation_Click" />
                                        <Separator />
                                        <MenuItem Header="Run as administrator" Tag="{Binding Application}" IsEnabled="{Binding CanRunApplicationAsAdministrator}" Click="RunAsAdministrator_Click" />
                                    </ContextMenu>
                                </StackPanel.ContextMenu>
                                <Grid Style="{StaticResource StartFlyoutIconHost}" Margin="4,0,6,0" VerticalAlignment="Center">
                                    <Image Source="{Binding Application.Icon}" Style="{StaticResource StartFlyoutIcon}" />
                                    <Border CornerRadius="5" Background="{DynamicResource DesktopAccentTintBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers><DataTrigger Binding="{Binding Application.Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Name}" MaxWidth="22" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource DesktopAccentTextBrush}" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding Name}" FontSize="13" Padding="1,4" VerticalAlignment="Center" />
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="Padding" Value="4,3" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
                <TextBlock x:Name="EmptyMessage" Grid.Row="2" Text="No matching apps. Try a different search." Foreground="{DynamicResource DesktopMutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
            <Border x:Name="QuickLinksBorder" Grid.Row="3" BorderBrush="{DynamicResource DesktopDividerBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                <StackPanel x:Name="QuickLinksStack" Orientation="Horizontal">
                    <TextBlock x:Name="QuickLinksTitle" Text="Places" Foreground="{DynamicResource DesktopSoftTextBrush}" FontSize="11" FontWeight="Bold" Visibility="Collapsed" Margin="0,0,0,12" />
                    <Button Content="Documents" Tag="documents" Click="QuickLink_Click" Padding="9,7" Margin="0,0,7,0" Background="{DynamicResource DesktopSurfaceBrush}" Foreground="{DynamicResource DesktopPrimaryTextBrush}" BorderBrush="{DynamicResource DesktopBorderBrush}" />
                    <Button Content="Downloads" Tag="downloads" Click="QuickLink_Click" Padding="9,7" Margin="0,0,7,0" Background="{DynamicResource DesktopSurfaceBrush}" Foreground="{DynamicResource DesktopPrimaryTextBrush}" BorderBrush="{DynamicResource DesktopBorderBrush}" />
                    <Button Content="Settings" Tag="settings" Click="QuickLink_Click" Padding="9,7" Background="{DynamicResource DesktopSurfaceBrush}" Foreground="{DynamicResource DesktopPrimaryTextBrush}" BorderBrush="{DynamicResource DesktopBorderBrush}" />
                    <Button Content="More" Click="MorePlaces_Click" Padding="9,7" Margin="0,0,7,0" Background="{DynamicResource DesktopSurfaceBrush}" Foreground="{DynamicResource DesktopPrimaryTextBrush}" BorderBrush="{DynamicResource DesktopBorderBrush}" ToolTip="Open more system places">
                        <Button.ContextMenu><ContextMenu /></Button.ContextMenu>
                    </Button>
                    <Button Content="⏻" Tag="power" Click="QuickLink_Click" Padding="11,7" Margin="7,0,0,0" Background="{DynamicResource DesktopAccentTintBrush}" BorderBrush="{DynamicResource DesktopBorderBrush}" Foreground="{DynamicResource DesktopAccentTextBrush}" HorizontalAlignment="Right" ToolTip="Power options">
                        <Button.ContextMenu><ContextMenu /></Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
