<Window x:Class="DesktopTuner.RunDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Run" Width="520" Height="250" MinWidth="460" MinHeight="240"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource DesktopSurfaceAltBrush}" Foreground="{DynamicResource DesktopPrimaryTextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" SourceInitialized="Window_SourceInitialized" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource DesktopAccentTintBrush}" Margin="0,0,12,0">
                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{DynamicResource DesktopAccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Run" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="Open a program, folder, document, or Internet address." FontSize="11" Foreground="{DynamicResource DesktopMutedTextBrush}" Margin="0,3,0,0" />
            </StackPanel>
        </StackPanel>
        <TextBlock Grid.Row="1" Text="Open:" FontSize="12" VerticalAlignment="Center" Margin="0,0,0,6" />
        <DockPanel Grid.Row="2" LastChildFill="True">
            <Button Content="Browse…" DockPanel.Dock="Right" MinWidth="82" Margin="8,0,0,0" Padding="10,5" Click="Browse_Click" />
            <ComboBox x:Name="CommandBox" Height="34" Padding="9,4" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                      Background="{DynamicResource DesktopSurfaceBrush}" Foreground="{DynamicResource DesktopPrimaryTextBrush}"
                      AutomationProperties.Name="Program, folder, document, or Internet address">
                <ComboBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Clear history" Click="ClearHistory_Click" />
                    </ContextMenu>
                </ComboBox.ContextMenu>
            </ComboBox>
        </DockPanel>
        <CheckBox x:Name="RunAsAdministratorCheckBox" Grid.Row="3" Content="Run as administrator" Margin="1,12,0,0"
                  VerticalAlignment="Top" Foreground="{DynamicResource DesktopPrimaryTextBrush}" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,16,0,0">
            <Button Content="OK" MinWidth="82" IsDefault="True" Margin="0,0,8,0" Padding="12,6" Click="Run_Click" />
            <Button Content="Cancel" MinWidth="82" IsCancel="True" Padding="12,6" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
