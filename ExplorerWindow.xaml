<Window x:Class="DesktopTuner.ExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DesktopTuner"
        Title="Desktop Tuner Explorer" Height="700" Width="1060" MinHeight="500" MinWidth="760"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource DesktopWindowBrush}" Foreground="{DynamicResource DesktopPrimaryTextBrush}" FontFamily="Segoe UI Variable Text, Segoe UI" PreviewKeyDown="ExplorerWindow_PreviewKeyDown" SourceInitialized="Window_SourceInitialized">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource DesktopSurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DesktopPrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DesktopBorderBrush}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource DesktopSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DesktopPrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DesktopInputBorderBrush}" />
        </Style>
        <Style TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource DesktopSurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DesktopPrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DesktopBorderBrush}" />
        </Style>
        <Style x:Key="DriveCapacityProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Width" Value="184" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Background" Value="{DynamicResource DesktopDividerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DesktopAccentTextBrush}" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasDriveSpace}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DriveSpaceTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DesktopMutedTextBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasDriveSpace}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ListViewItem">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCut}" Value="True"><Setter Property="Opacity" Value="0.55" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="ExplorerListItemTemplate">
            <Grid MinHeight="28" Margin="0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,8,0" Stretch="Uniform" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}" />
                    <ProgressBar Style="{StaticResource DriveCapacityProgressStyle}" Value="{Binding DriveUsagePercent}" />
                    <TextBlock Text="{Binding DriveSpaceText}" Style="{StaticResource DriveSpaceTextStyle}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ExplorerMediumIconTemplate">
            <StackPanel Width="196" MinHeight="112" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="{Binding Icon}" Width="44" Height="44" Margin="0,5,0,7" HorizontalAlignment="Center" Stretch="Uniform" />
                <TextBlock Text="{Binding DisplayName}" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="38" />
                <ProgressBar Style="{StaticResource DriveCapacityProgressStyle}" HorizontalAlignment="Center" Value="{Binding DriveUsagePercent}" />
                <TextBlock Text="{Binding DriveSpaceText}" Style="{StaticResource DriveSpaceTextStyle}" TextAlignment="Center" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ExplorerSmallIconTemplate">
            <StackPanel Orientation="Horizontal" MinHeight="24" Margin="4,1" VerticalAlignment="Center">
                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="5,0,8,0" Stretch="Uniform" />
                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ExplorerTilesTemplate">
            <StackPanel Width="286" MinHeight="66" Margin="5" Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="{Binding Icon}" Width="40" Height="40" Margin="8,0,12,0" Stretch="Uniform" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center" MinWidth="190">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Type}" Foreground="{DynamicResource DesktopMutedTextBrush}" FontSize="11" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding ModifiedText}" Foreground="{DynamicResource DesktopMutedTextBrush}" FontSize="10" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding SizeText}" Foreground="{DynamicResource DesktopMutedTextBrush}" FontSize="10" Margin="0,2,0,0" />
                    <ProgressBar Style="{StaticResource DriveCapacityProgressStyle}" Value="{Binding DriveUsagePercent}" />
                    <TextBlock Text="{Binding DriveSpaceText}" Style="{StaticResource DriveSpaceTextStyle}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ExplorerLargeIconTemplate">
            <StackPanel Width="220" MinHeight="142" Margin="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="{Binding Icon}" Width="72" Height="72" Margin="0,4,0,9" HorizontalAlignment="Center" Stretch="Uniform" />
                <TextBlock Text="{Binding DisplayName}" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40" />
                <ProgressBar Style="{StaticResource DriveCapacityProgressStyle}" HorizontalAlignment="Center" Value="{Binding DriveUsagePercent}" />
                <TextBlock Text="{Binding DriveSpaceText}" Style="{StaticResource DriveSpaceTextStyle}" TextAlignment="Center" />
            </StackPanel>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="ExplorerVerticalItemsPanel"><VirtualizingStackPanel /></ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ExplorerWrapItemsPanel"><WrapPanel /></ItemsPanelTemplate>
        <HierarchicalDataTemplate x:Key="ExplorerNavigationNodeTemplate" DataType="{x:Type local:ExplorerNavigationNode}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
        </HierarchicalDataTemplate>
        <Style x:Key="ExplorerNavigationTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="Padding" Value="3,4" />
            <EventSetter Event="Expanded" Handler="NavigationTreeItem_Expanded" />
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="DetailsPaneSplitterRow" Height="8" />
            <RowDefinition x:Name="DetailsPaneRow" Height="160" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource DesktopSurfaceBrush}" BorderBrush="{DynamicResource DesktopBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="BackButton" Content="←" ToolTip="Back" Width="38" Height="36" Margin="0,0,6,0" Click="Back_Click" />
                    <Button x:Name="ForwardButton" Content="→" ToolTip="Forward" Width="38" Height="36" Margin="0,0,6,0" Click="Forward_Click" />
                    <Button x:Name="UpButton" Content="↑" ToolTip="Up one level" Width="38" Height="36" Margin="0,0,12,0" Click="Up_Click" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                    <TextBox x:Name="SearchBox" Width="230" Height="36" VerticalContentAlignment="Center" Padding="10,0" ToolTip="Search names or use *.pdf, ext:pdf, kind:document, kind:folder, after:yyyy-MM-dd, before:yyyy-MM-dd, or size:>=10MB" KeyDown="SearchBox_KeyDown" />
                    <Button x:Name="SearchButton" Content="Search" Margin="6,0,0,0" Padding="14,0" Click="Search_Click" />
                </StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="Location" Foreground="{DynamicResource DesktopMutedTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Grid>
                        <ScrollViewer x:Name="AddressBreadcrumbsScroll" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
                            <StackPanel x:Name="AddressBreadcrumbs" Orientation="Horizontal" VerticalAlignment="Center" />
                        </ScrollViewer>
                        <TextBox x:Name="AddressBox" Height="36" VerticalContentAlignment="Center" Padding="10,0" KeyDown="AddressBox_KeyDown" Visibility="Collapsed" />
                    </Grid>
                    <Button Content="Go" Margin="6,0,0,0" Padding="14,0" Click="Go_Click" />
                </DockPanel>
            </DockPanel>
        </Border>
        <Border Grid.Row="2" Background="{DynamicResource DesktopSurfaceBrush}" BorderBrush="{DynamicResource DesktopBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="4">
            <TabControl x:Name="CommandRibbon" Background="Transparent" BorderThickness="0">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Padding" Value="14,5" />
                        <Setter Property="Margin" Value="2,0" />
                    </Style>
                </TabControl.ItemContainerStyle>
                <TabItem Header="Home">
                    <StackPanel Orientation="Horizontal" Margin="8,6">
                        <StackPanel Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="NewFolderButton" Content="New folder" Padding="12,6" Margin="0,0,5,0" Click="NewFolder_Click" />
                                <Button x:Name="RenameButton" Content="Rename" Padding="12,6" IsEnabled="False" Click="Rename_Click" />
                            </StackPanel>
                            <TextBlock Text="Organize" HorizontalAlignment="Center" Foreground="{DynamicResource DesktopMutedTextBrush}" FontSize="10" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Width="1" Background="{DynamicResource DesktopDividerBrush}" Margin="0,2,12,2" />
                        <StackPanel Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="CutButton" Content="Cut" Padding="12,6" Margin="0,0,5,0" IsEnabled="False" Click="Cut_Click" />
                                <Button x:Name="CopyButton" Content="Copy" Padding="12,6" Margin="0,0,5,0" IsEnabled="False" Click="Copy_Click" />
                                <Button x:Name="PasteButton" Content="Paste" Padding="12,6" IsEnabled="False" Click="Paste_Click" />
                            </StackPanel>
                            <TextBlock Text="Clipboard" HorizontalAlignment="Center" Foreground="{DynamicResource DesktopMutedTextBrush}" FontSize="10" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Width="1" Background="{DynamicResource DesktopDividerBrush}" Margin="0,2,12,2" />
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="DeleteButton" Content="Delete" Padding="12,6" Margin="0,0,5,0" IsEnabled="False" Click="Delete_Click" />
                                <Button x:Name="RefreshButton" Content="Refresh" Padding="12,6" Click="Refresh_Click" />
                            </StackPanel>
                            <TextBlock Text="Manage" HorizontalAlignment="Center" Foreground="{DynamicResource DesktopMutedTextBrush}" FontSize="10" Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Share">
                    <StackPanel Orientation="Horizontal" Margin="8,6">
                        <Button x:Name="OpenSelectedButton" Content="Open" Padding="14,6" Margin="0,0,5,0" IsEnabled="False" Click="OpenSelected_Click" />
                        <Button x:Name="OpenInNewTabButton" Content="Open in new tab" Padding="14,6" Margin="0,0,5,0" IsEnabled="False" Click="OpenInNewTab_Click" />
                        <Button x:Name="CopyPathButton" Content="Copy path" Padding="14,6" IsEnabled="False" Click="CopyPath_Click" />
                    </StackPanel>
                </TabItem>
                <TabItem Header="View">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,6">
                        <TextBlock Text="Layout" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource DesktopMutedTextBrush}" />
                        <ComboBox x:Name="ViewModeSelector" Width="138" Height="32" VerticalContentAlignment="Center" SelectionChanged="ViewModeSelector_SelectionChanged">
                            <ComboBoxItem Content="Details" Tag="Details" />
                            <ComboBoxItem Content="List" Tag="List" />
                            <ComboBoxItem Content="Small icons" Tag="SmallIcons" />
                            <ComboBoxItem Content="Medium icons" Tag="MediumIcons" />
                            <ComboBoxItem Content="Large icons" Tag="LargeIcons" />
                            <ComboBoxItem Content="Tiles" Tag="Tiles" />
                        </ComboBox>
                        <Border Width="1" Background="{DynamicResource DesktopDividerBrush}" Margin="12,2,12,2" />
                        <TextBlock Text="Sort by" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource DesktopMutedTextBrush}" />
                        <ComboBox x:Name="SortBySelector" Width="150" Height="32" VerticalContentAlignment="Center" SelectionChanged="SortBySelector_SelectionChanged">
                            <ComboBoxItem Content="Name" Tag="Name" />
                            <ComboBoxItem Content="Date modified" Tag="DateModified" />
                            <ComboBoxItem Content="Type" Tag="Type" />
                            <ComboBoxItem Content="Size" Tag="Size" />
                            <ComboBoxItem Content="Date created" Tag="DateCreated" />
                            <ComboBoxItem Content="Date accessed" Tag="DateAccessed" />
                        </ComboBox>
                        <Button x:Name="SortDirectionButton" Content="Ascending ↑" Margin="6,0,14,0" Padding="12,6" Click="SortDirectionButton_Click" />
                        <CheckBox x:Name="GroupDrivesToggle" Content="Group drives by type" VerticalAlignment="Center" Margin="0,0,14,0" Click="GroupDrivesToggle_Click" />
                        <ToggleButton x:Name="DetailsPaneToggle" Content="Details pane" IsChecked="True" Padding="12,6" Click="DetailsPaneToggle_Click" />
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Border>
        <Border Grid.Row="4" Background="{DynamicResource DesktopSurfaceBrush}" BorderBrush="{DynamicResource DesktopBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="QUICK ACCESS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DesktopSoftTextBrush}" Margin="8,4,0,10" />
                        <Button Content="Home" Tag="home" HorizontalContentAlignment="Left" Padding="10,8" Click="QuickLocation_Click" />
                        <Button Content="Desktop" Tag="desktop" HorizontalContentAlignment="Left" Padding="10,8" Click="QuickLocation_Click" />
                        <Button Content="Documents" Tag="documents" HorizontalContentAlignment="Left" Padding="10,8" Click="QuickLocation_Click" />
                        <Button Content="Downloads" Tag="downloads" HorizontalContentAlignment="Left" Padding="10,8" Click="QuickLocation_Click" />
                        <Button Content="Pictures" Tag="pictures" HorizontalContentAlignment="Left" Padding="10,8" Click="QuickLocation_Click" />
                        <TextBlock Text="PINNED FOLDERS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DesktopSoftTextBrush}" Margin="8,18,0,6" />
                        <StackPanel x:Name="QuickAccessPinsPanel" AllowDrop="True" DragOver="QuickAccessPinsPanel_DragOver" Drop="QuickAccessPinsPanel_Drop" />
                        <TextBlock Text="THIS PC" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DesktopSoftTextBrush}" Margin="8,18,0,10" />
                        <Button Content="Local drives" Tag="drives" HorizontalContentAlignment="Left" Padding="10,8" Click="QuickLocation_Click" />
                        <TextBlock Text="FOLDERS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DesktopSoftTextBrush}" Margin="8,18,0,6" />
                        <TreeView x:Name="NavigationTree" Background="Transparent" BorderThickness="0" ItemTemplate="{StaticResource ExplorerNavigationNodeTemplate}" ItemContainerStyle="{StaticResource ExplorerNavigationTreeItemStyle}" SelectedItemChanged="NavigationTree_SelectedItemChanged" />
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Column="1" Background="{DynamicResource DesktopDividerBrush}" />
                <DockPanel Grid.Column="2" Margin="16,12,12,12">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <DockPanel Margin="0,0,0,10">
                            <Button Content="+" DockPanel.Dock="Right" Width="34" Height="30" Margin="6,0,0,0" ToolTip="New tab (Ctrl+T)" Click="NewTabButton_Click" />
                            <TabControl x:Name="ExplorerTabs" Height="32" SelectionChanged="ExplorerTabs_SelectionChanged" BorderThickness="0" Background="Transparent">
                                <TabControl.ContextMenu>
                                    <ContextMenu Opened="ExplorerTabsContextMenu_Opened">
                                        <MenuItem x:Name="ReopenClosedTabMenuItem" Header="Reopen closed tab" InputGestureText="Ctrl+Shift+T" IsEnabled="False" Click="ReopenClosedTab_Click" />
                                    </ContextMenu>
                                </TabControl.ContextMenu>
                            </TabControl>
                        </DockPanel>
                        <TextBlock x:Name="LocationTitle" Text="Home" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource DesktopPrimaryTextBrush}" />
                        <TextBlock x:Name="LocationSubtitle" Foreground="{DynamicResource DesktopMutedTextBrush}" FontSize="12" Margin="0,3,0,0" />
                    </StackPanel>
                    <ListView x:Name="EntriesList" SelectionMode="Extended" SelectionChanged="EntriesList_SelectionChanged" MouseDoubleClick="EntriesList_MouseDoubleClick" PreviewKeyDown="EntriesList_PreviewKeyDown" PreviewMouseDown="EntriesList_PreviewMouseDown" PreviewMouseLeftButtonDown="EntriesList_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="EntriesList_PreviewMouseLeftButtonUp" PreviewMouseMove="EntriesList_PreviewMouseMove" PreviewMouseRightButtonDown="EntriesList_PreviewMouseRightButtonDown" DragOver="EntriesList_DragOver" Drop="EntriesList_Drop" AllowDrop="True" BorderThickness="0" Background="Transparent">
                        <ListView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource DesktopMutedTextBrush}" Margin="4,14,0,6" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>
                        <ListView.ContextMenu>
                            <ContextMenu Opened="EntriesContextMenu_Opened">
                                <MenuItem Header="Open" Click="OpenSelected_Click" />
                                <MenuItem x:Name="PropertiesMenuItem" Header="Properties" Click="Properties_Click" />
                                <Separator />
                                <MenuItem x:Name="OpenInNewTabMenuItem" Header="Open in new tab" Click="OpenInNewTab_Click" />
                                <MenuItem x:Name="PinQuickAccessMenuItem" Header="Pin to quick access" Click="PinQuickAccess_Click" />
                                <MenuItem x:Name="UnpinQuickAccessMenuItem" Header="Remove from quick access" Click="UnpinQuickAccess_Click" />
                                <MenuItem Header="New folder" Click="NewFolder_Click" />
                                <Separator />
                                <MenuItem x:Name="CutMenuItem" Header="Cut" InputGestureText="Ctrl+X" IsEnabled="False" Click="Cut_Click" />
                                <MenuItem x:Name="CopyMenuItem" Header="Copy" InputGestureText="Ctrl+C" IsEnabled="False" Click="Copy_Click" />
                                <MenuItem x:Name="PasteMenuItem" Header="Paste" InputGestureText="Ctrl+V" IsEnabled="False" Click="Paste_Click" />
                                <Separator />
                                <MenuItem x:Name="RenameMenuItem" Header="Rename" IsEnabled="False" Click="Rename_Click" />
                                <MenuItem x:Name="DeleteMenuItem" Header="Send to Recycle Bin" IsEnabled="False" Click="Delete_Click" />
                                <Separator />
                                <MenuItem Header="Refresh" Click="Refresh_Click" />
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.View>
                            <GridView x:Name="ExplorerDetailsGridView">
                                <GridViewColumn Width="360">
                                    <GridViewColumn.Header><GridViewColumnHeader x:Name="NameColumnHeader" Tag="Name" Click="SortColumn_Click" SizeChanged="DetailsColumnHeader_SizeChanged">Name</GridViewColumnHeader></GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Image Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Top" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                    <ProgressBar Style="{StaticResource DriveCapacityProgressStyle}" Value="{Binding DriveUsagePercent}" />
                                                    <TextBlock Text="{Binding DriveSpaceText}" Style="{StaticResource DriveSpaceTextStyle}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="155" DisplayMemberBinding="{Binding ModifiedText}">
                                    <GridViewColumn.Header><GridViewColumnHeader x:Name="DateModifiedColumnHeader" Tag="DateModified" Click="SortColumn_Click" SizeChanged="DetailsColumnHeader_SizeChanged">Date modified</GridViewColumnHeader></GridViewColumn.Header>
                                </GridViewColumn>
                                <GridViewColumn Width="130" DisplayMemberBinding="{Binding Type}">
                                    <GridViewColumn.Header><GridViewColumnHeader x:Name="TypeColumnHeader" Tag="Type" Click="SortColumn_Click" SizeChanged="DetailsColumnHeader_SizeChanged">Type</GridViewColumnHeader></GridViewColumn.Header>
                                </GridViewColumn>
                                <GridViewColumn Width="105" DisplayMemberBinding="{Binding SizeText}">
                                    <GridViewColumn.Header><GridViewColumnHeader x:Name="SizeColumnHeader" Tag="Size" Click="SortColumn_Click" SizeChanged="DetailsColumnHeader_SizeChanged">Size</GridViewColumnHeader></GridViewColumn.Header>
                                </GridViewColumn>
                                <GridViewColumn Width="155" DisplayMemberBinding="{Binding CreatedText}">
                                    <GridViewColumn.Header><GridViewColumnHeader x:Name="DateCreatedColumnHeader" Tag="DateCreated" Click="SortColumn_Click" SizeChanged="DetailsColumnHeader_SizeChanged">Date created</GridViewColumnHeader></GridViewColumn.Header>
                                </GridViewColumn>
                                <GridViewColumn Width="155" DisplayMemberBinding="{Binding AccessedText}">
                                    <GridViewColumn.Header><GridViewColumnHeader x:Name="DateAccessedColumnHeader" Tag="DateAccessed" Click="SortColumn_Click" SizeChanged="DetailsColumnHeader_SizeChanged">Date accessed</GridViewColumnHeader></GridViewColumn.Header>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <TextBlock x:Name="EmptyMessage" DockPanel.Dock="Bottom" Foreground="{DynamicResource DesktopSoftTextBrush}" Margin="4,8" Visibility="Collapsed" />
                </DockPanel>
            </Grid>
        </Border>
        <GridSplitter x:Name="DetailsPaneSplitter" Grid.Row="5" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      Background="{DynamicResource DesktopDividerBrush}" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="False" />
        <Border x:Name="DetailsPane" Grid.Row="6" Background="{DynamicResource DesktopSurfaceBrush}" BorderBrush="{DynamicResource DesktopBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" SizeChanged="DetailsPane_SizeChanged">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock Text="DETAILS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DesktopSoftTextBrush}" />
                    <TextBlock x:Name="DetailsName" DockPanel.Dock="Right" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource DesktopPrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <UniformGrid Grid.Row="1" Columns="3" Margin="0,14,0,0">
                    <StackPanel><TextBlock Text="Type" Foreground="{DynamicResource DesktopSoftTextBrush}" FontSize="11" /><TextBlock x:Name="DetailsType" Margin="0,5,14,0" TextWrapping="Wrap" /></StackPanel>
                    <StackPanel><TextBlock Text="Location" Foreground="{DynamicResource DesktopSoftTextBrush}" FontSize="11" /><TextBlock x:Name="DetailsLocation" Margin="0,5,14,0" TextTrimming="CharacterEllipsis" /></StackPanel>
                    <StackPanel><TextBlock Text="Size" Foreground="{DynamicResource DesktopSoftTextBrush}" FontSize="11" /><TextBlock x:Name="DetailsSize" Margin="0,5,14,0" /></StackPanel>
                    <StackPanel><TextBlock Text="Date modified" Foreground="{DynamicResource DesktopSoftTextBrush}" FontSize="11" /><TextBlock x:Name="DetailsModified" Margin="0,5,0,0" TextWrapping="Wrap" /></StackPanel>
                    <StackPanel><TextBlock Text="Date created" Foreground="{DynamicResource DesktopSoftTextBrush}" FontSize="11" /><TextBlock x:Name="DetailsCreated" Margin="0,5,14,0" TextWrapping="Wrap" /></StackPanel>
                    <StackPanel><TextBlock Text="Date accessed" Foreground="{DynamicResource DesktopSoftTextBrush}" FontSize="11" /><TextBlock x:Name="DetailsAccessed" Margin="0,5,14,0" TextWrapping="Wrap" /></StackPanel>
                </UniformGrid>
            </Grid>
        </Border>
        <TextBlock x:Name="StatusText" Grid.Row="7" Foreground="{DynamicResource DesktopMutedTextBrush}" FontSize="11" Margin="5,8,0,0" />
    </Grid>
</Window>
