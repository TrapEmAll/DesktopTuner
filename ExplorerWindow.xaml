<Window x:Class="DesktopTuner.ExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Tuner Explorer" Height="700" Width="1060" MinHeight="500" MinWidth="760"
        WindowStartupLocation="CenterOwner" Background="#F5F6FA" FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="160" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" BorderBrush="#DDE1EA" BorderThickness="1" CornerRadius="12" Padding="10">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="BackButton" Content="←" ToolTip="Back" Width="38" Height="36" Margin="0,0,6,0" Click="Back_Click" />
                    <Button x:Name="ForwardButton" Content="→" ToolTip="Forward" Width="38" Height="36" Margin="0,0,6,0" Click="Forward_Click" />
                    <Button x:Name="UpButton" Content="↑" ToolTip="Up one level" Width="38" Height="36" Margin="0,0,12,0" Click="Up_Click" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                    <TextBox x:Name="SearchBox" Width="230" Height="36" VerticalContentAlignment="Center" Padding="10,0" ToolTip="Search this folder" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown" />
                    <Button Content="Search" Margin="6,0,0,0" Padding="14,0" Click="Search_Click" />
                </StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="Location" Foreground="#697386" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="AddressBox" Height="36" VerticalContentAlignment="Center" Padding="10,0" KeyDown="AddressBox_KeyDown" />
                    <Button Content="Go" Margin="6,0,0,0" Padding="14,0" Click="Go_Click" />
                </DockPanel>
            </DockPanel>
        </Border>
        <Border Grid.Row="2" Background="White" BorderBrush="#DDE1EA" BorderThickness="1" CornerRadius="12" Padding="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="12">
                    <TextBlock Text="QUICK ACCESS" FontSize="10" FontWeight="Bold" Foreground="#7B8495" Margin="8,4,0,10" />
                    <Button Content="Home" Tag="home" HorizontalContentAlignment="Left" Padding="10,8" Click="QuickLocation_Click" />
                    <Button Content="Desktop" Tag="desktop" HorizontalContentAlignment="Left" Padding="10,8" Click="QuickLocation_Click" />
                    <Button Content="Documents" Tag="documents" HorizontalContentAlignment="Left" Padding="10,8" Click="QuickLocation_Click" />
                    <Button Content="Downloads" Tag="downloads" HorizontalContentAlignment="Left" Padding="10,8" Click="QuickLocation_Click" />
                    <Button Content="Pictures" Tag="pictures" HorizontalContentAlignment="Left" Padding="10,8" Click="QuickLocation_Click" />
                    <TextBlock Text="THIS PC" FontSize="10" FontWeight="Bold" Foreground="#7B8495" Margin="8,18,0,10" />
                    <Button Content="Local drives" Tag="drives" HorizontalContentAlignment="Left" Padding="10,8" Click="QuickLocation_Click" />
                </StackPanel>
                <Border Grid.Column="1" Background="#E7E9EF" />
                <DockPanel Grid.Column="2" Margin="16,12,12,12">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock x:Name="LocationTitle" Text="Home" FontSize="21" FontWeight="SemiBold" Foreground="#172033" />
                        <TextBlock x:Name="LocationSubtitle" Foreground="#697386" FontSize="12" Margin="0,3,0,0" />
                    </StackPanel>
                    <ListView x:Name="EntriesList" SelectionChanged="EntriesList_SelectionChanged" MouseDoubleClick="EntriesList_MouseDoubleClick" BorderThickness="0" Background="Transparent">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" Width="360" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="Date modified" Width="155" DisplayMemberBinding="{Binding ModifiedText}" />
                                <GridViewColumn Header="Type" Width="130" DisplayMemberBinding="{Binding Type}" />
                                <GridViewColumn Header="Size" Width="105" DisplayMemberBinding="{Binding SizeText}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <TextBlock x:Name="EmptyMessage" DockPanel.Dock="Bottom" Foreground="#7B8495" Margin="4,8" Visibility="Collapsed" />
                </DockPanel>
            </Grid>
        </Border>
        <Border Grid.Row="4" Background="White" BorderBrush="#DDE1EA" BorderThickness="1" CornerRadius="12" Padding="16">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock Text="DETAILS" FontSize="10" FontWeight="Bold" Foreground="#7B8495" />
                    <TextBlock x:Name="DetailsName" DockPanel.Dock="Right" FontSize="13" FontWeight="SemiBold" Foreground="#172033" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <UniformGrid Grid.Row="1" Columns="4" Margin="0,14,0,0">
                    <StackPanel><TextBlock Text="Type" Foreground="#7B8495" FontSize="11" /><TextBlock x:Name="DetailsType" Margin="0,5,14,0" TextWrapping="Wrap" /></StackPanel>
                    <StackPanel><TextBlock Text="Location" Foreground="#7B8495" FontSize="11" /><TextBlock x:Name="DetailsLocation" Margin="0,5,14,0" TextTrimming="CharacterEllipsis" /></StackPanel>
                    <StackPanel><TextBlock Text="Size" Foreground="#7B8495" FontSize="11" /><TextBlock x:Name="DetailsSize" Margin="0,5,14,0" /></StackPanel>
                    <StackPanel><TextBlock Text="Date modified" Foreground="#7B8495" FontSize="11" /><TextBlock x:Name="DetailsModified" Margin="0,5,0,0" TextWrapping="Wrap" /></StackPanel>
                </UniformGrid>
            </Grid>
        </Border>
        <TextBlock x:Name="StatusText" Grid.Row="5" Foreground="#697386" FontSize="11" Margin="5,8,0,0" />
    </Grid>
</Window>
