<Window x:Class="DesktopTuner.ShellNamespaceBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Tuner Explorer" Width="900" Height="620" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource DesktopWindowBrush}"
        Foreground="{DynamicResource DesktopPrimaryTextBrush}" FontFamily="Segoe UI Variable Text, Segoe UI"
        SourceInitialized="Window_SourceInitialized" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,10,0">
                <Button Content="Back" Padding="12,6" Margin="0,0,6,0" Click="Back_Click" />
                <Button Content="Forward" Padding="12,6" Margin="0,0,6,0" Click="Forward_Click" />
                <Button Content="Up" Padding="12,6" Click="Up_Click" />
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="Go" Padding="14,6" Margin="8,0,0,0" Click="Go_Click" />
            <TextBox x:Name="AddressBox" Padding="10,7" VerticalContentAlignment="Center" KeyDown="AddressBox_KeyDown" />
        </DockPanel>
        <DockPanel Grid.Row="1" Margin="0,10,0,0" LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="Search" Padding="14,6" Margin="8,0,0,0" Click="Search_Click" />
            <Button x:Name="CancelSearchButton" DockPanel.Dock="Right" Content="Cancel" Padding="12,6" Margin="0,0,8,0" IsEnabled="False" Click="CancelSearch_Click" />
            <TextBox x:Name="SearchBox" Padding="10,7" VerticalContentAlignment="Center"
                     ToolTip="Search this location and its subfolders. Filters: *.pdf, ext:pdf, kind:document, kind:folder, after:yyyy-MM-dd, before:yyyy-MM-dd, size:&gt;=10MB, content:&quot;phrase&quot;."
                     KeyDown="SearchBox_KeyDown" />
        </DockPanel>
        <ListView x:Name="ItemsList" Grid.Row="2" Margin="0,10,0,0" MouseDoubleClick="ItemsList_MouseDoubleClick"
                  SelectionMode="Single">
            <ListView.ContextMenu>
                <ContextMenu Opened="ItemContextMenu_Opened">
                    <MenuItem Header="Open" Click="Open_Click" />
                    <MenuItem x:Name="ShowMoreOptionsMenuItem" Header="Show more options" Click="ShowMoreOptions_Click" />
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="380">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Type" Width="140" DisplayMemberBinding="{Binding Type}" />
                    <GridViewColumn Header="Location" Width="300" DisplayMemberBinding="{Binding ParsingName}" />
                </GridView>
            </ListView.View>
        </ListView>
        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="4,9,0,0" Foreground="{DynamicResource DesktopMutedTextBrush}" />
    </Grid>
</Window>
