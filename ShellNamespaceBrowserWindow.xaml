<Window x:Class="DesktopTuner.ShellNamespaceBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Tuner Explorer" Width="900" Height="620" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource DesktopWindowBrush}"
        Foreground="{DynamicResource DesktopPrimaryTextBrush}" FontFamily="Segoe UI Variable Text, Segoe UI"
        SourceInitialized="Window_SourceInitialized" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <DataTemplate x:Key="ShellNamespaceNameTemplate">
            <Grid MinWidth="80" MaxWidth="240">
                <TextBlock x:Name="ShellNamespaceItemName" Text="{Binding Name}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                <TextBox x:Name="ShellNamespaceItemNameEditor"
                         Text="{Binding RenameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="Collapsed" MinWidth="80" MaxWidth="240" Padding="2,0"
                         LostKeyboardFocus="RenameEditor_LostKeyboardFocus" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                    <Setter TargetName="ShellNamespaceItemName" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="ShellNamespaceItemNameEditor" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="ShellNamespaceListItemTemplate">
            <StackPanel Orientation="Horizontal" MinHeight="28" Margin="2,1" VerticalAlignment="Center">
                <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,8,0" Stretch="Uniform" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ShellNamespaceNameTemplate}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ShellNamespaceSmallIconTemplate">
            <StackPanel Orientation="Horizontal" MinHeight="24" Margin="4,1" VerticalAlignment="Center">
                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="5,0,8,0" Stretch="Uniform" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ShellNamespaceNameTemplate}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ShellNamespaceMediumIconTemplate">
            <StackPanel Width="176" MinHeight="106" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="{Binding Icon}" Width="44" Height="44" Margin="0,5,0,7" HorizontalAlignment="Center" Stretch="Uniform" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ShellNamespaceNameTemplate}" HorizontalAlignment="Center" MaxHeight="40" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ShellNamespaceLargeIconTemplate">
            <StackPanel Width="196" MinHeight="138" Margin="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="{Binding Icon}" Width="72" Height="72" Margin="0,4,0,9" HorizontalAlignment="Center" Stretch="Uniform" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ShellNamespaceNameTemplate}" HorizontalAlignment="Center" MaxHeight="42" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ShellNamespaceTilesTemplate">
            <StackPanel Width="286" MinHeight="68" Margin="5" Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="{Binding Icon}" Width="40" Height="40" Margin="8,0,12,0" Stretch="Uniform" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center" MinWidth="190">
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ShellNamespaceNameTemplate}" />
                    <TextBlock Text="{Binding Type}" Foreground="{DynamicResource DesktopMutedTextBrush}" FontSize="11" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding ParsingName}" Foreground="{DynamicResource DesktopMutedTextBrush}" FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="ShellNamespaceVerticalItemsPanel"><VirtualizingStackPanel /></ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ShellNamespaceWrapItemsPanel"><WrapPanel /></ItemsPanelTemplate>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,10,0">
                <Button Content="Back" Padding="12,6" Margin="0,0,6,0" Click="Back_Click" />
                <Button Content="Forward" Padding="12,6" Margin="0,0,6,0" Click="Forward_Click" />
                <Button Content="Up" Padding="12,6" Margin="0,0,6,0" Click="Up_Click" />
                <Button Content="Refresh" Padding="12,6" Click="Refresh_Click" />
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="Go" Padding="14,6" Margin="8,0,0,0" Click="Go_Click" />
            <TextBox x:Name="AddressBox" Padding="10,7" VerticalContentAlignment="Center" KeyDown="AddressBox_KeyDown" />
        </DockPanel>
        <DockPanel Grid.Row="1" Margin="0,10,0,0" LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="Search" Padding="14,6" Margin="8,0,0,0" Click="Search_Click" />
            <Button x:Name="CancelSearchButton" DockPanel.Dock="Right" Content="Cancel" Padding="12,6" Margin="0,0,8,0" IsEnabled="False" Click="CancelSearch_Click" />
            <ComboBox x:Name="ViewModeSelector" DockPanel.Dock="Right" Width="150" Margin="0,0,8,0" Padding="8,4"
                      VerticalContentAlignment="Center" ToolTip="Choose how Shell items are displayed."
                      SelectionChanged="ViewModeSelector_SelectionChanged">
                <ComboBoxItem Content="Details" Tag="Details" />
                <ComboBoxItem Content="List" Tag="List" />
                <ComboBoxItem Content="Small icons" Tag="SmallIcons" />
                <ComboBoxItem Content="Medium icons" Tag="MediumIcons" />
                <ComboBoxItem Content="Large icons" Tag="LargeIcons" />
                <ComboBoxItem Content="Tiles" Tag="Tiles" />
            </ComboBox>
            <TextBox x:Name="SearchBox" Padding="10,7" VerticalContentAlignment="Center"
                     ToolTip="Search this location and its subfolders. Filters: *.pdf, ext:pdf, kind:document, kind:folder, after:yyyy-MM-dd, before:yyyy-MM-dd, size:&gt;=10MB, content:&quot;phrase&quot;."
                     KeyDown="SearchBox_KeyDown" />
        </DockPanel>
        <ListView x:Name="ItemsList" Grid.Row="2" Margin="0,10,0,0" MouseDoubleClick="ItemsList_MouseDoubleClick"
                  PreviewMouseRightButtonDown="ItemsList_PreviewMouseRightButtonDown"
                  PreviewMouseLeftButtonDown="ItemsList_PreviewMouseLeftButtonDown"
                  PreviewMouseLeftButtonUp="ItemsList_PreviewMouseLeftButtonUp"
                  PreviewMouseMove="ItemsList_PreviewMouseMove"
                  SelectionMode="Extended" ItemsPanel="{StaticResource ShellNamespaceVerticalItemsPanel}">
            <ListView.ContextMenu>
                <ContextMenu Opened="ItemContextMenu_Opened">
                    <MenuItem x:Name="OpenMenuItem" Header="Open" Click="Open_Click" />
                    <Separator />
                    <MenuItem x:Name="CopyMenuItem" Header="Copy" IsEnabled="False" Click="Copy_Click" />
                    <MenuItem x:Name="CutMenuItem" Header="Cut" IsEnabled="False" Click="Cut_Click" />
                    <MenuItem Header="Paste" Click="Paste_Click" />
                    <MenuItem x:Name="NewFolderMenuItem" Header="New folder" Click="NewFolder_Click" />
                    <Separator />
                    <MenuItem x:Name="DeleteMenuItem" Header="Delete" InputGestureText="Del" Click="Delete_Click" />
                    <MenuItem x:Name="PropertiesMenuItem" Header="Properties" Click="Properties_Click" />
                    <MenuItem x:Name="RenameMenuItem" Header="Rename" IsEnabled="False" Click="Rename_Click" />
                    <MenuItem x:Name="PinStartMenuItem" Header="Pin to Start" Visibility="Collapsed" Click="PinStart_Click" />
                    <MenuItem x:Name="PinTaskbarMenuItem" Header="Pin to taskbar" Visibility="Collapsed" Click="PinTaskbar_Click" />
                    <MenuItem x:Name="ShowMoreOptionsMenuItem" Header="Show more options" Click="ShowMoreOptions_Click" />
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.View>
                <GridView x:Name="ShellNamespaceDetailsGridView">
                    <GridViewColumn Header="Name" Width="380">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,8,0" />
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ShellNamespaceNameTemplate}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Type" Width="140" DisplayMemberBinding="{Binding Type}" />
                    <GridViewColumn Header="Location" Width="300" DisplayMemberBinding="{Binding ParsingName}" />
                </GridView>
            </ListView.View>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCut}" Value="True">
                            <Setter Property="Opacity" Value="0.5" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="4,9,0,0" Foreground="{DynamicResource DesktopMutedTextBrush}" />
    </Grid>
</Window>
