<Application x:Class="DesktopTuner.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DesktopTuner">
    <Application.Resources>
        <Thickness x:Key="TouchMenuItemPadding">10,7,10,7</Thickness>
        <sys:Double x:Key="TouchMenuItemMinimumHeight" xmlns:sys="clr-namespace:System;assembly=mscorlib">32</sys:Double>
        <CornerRadius x:Key="TaskbarButtonCornerRadius">8</CornerRadius>
        <CornerRadius x:Key="TaskbarSegmentCornerRadius">11</CornerRadius>
        <SolidColorBrush x:Key="TaskbarButtonBorderBrush" Color="Transparent" />
        <Thickness x:Key="TaskbarButtonBorderThickness">0</Thickness>
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource DesktopSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DesktopPrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DesktopBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="local:AcrylicContextMenuBehavior.IsEnabled" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource DesktopPrimaryTextBrush}" />
            <Setter Property="Padding" Value="{DynamicResource TouchMenuItemPadding}" />
            <Setter Property="MinHeight" Value="{DynamicResource TouchMenuItemMinimumHeight}" />
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource DesktopSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DesktopPrimaryTextBrush}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="local:AcrylicToolTipBehavior.IsEnabled" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource DesktopBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
