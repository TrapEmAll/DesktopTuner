<Window x:Class="DesktopTuner.TaskbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DesktopTuner"
        Title="Desktop Tuner Taskbar" Height="54" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" Background="Transparent" AllowsTransparency="True"
        Foreground="{DynamicResource TaskbarForegroundBrush}" FontFamily="Segoe UI Variable Text, Segoe UI"
        AllowDrop="True" DragOver="Window_DragOver" DragLeave="Window_DragLeave" Drop="Window_Drop"
        Loaded="Window_Loaded" Closed="Window_Closed" Deactivated="Taskbar_Deactivated" PreviewKeyDown="Taskbar_PreviewKeyDown" MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave">
    <Window.ContextMenu>
        <ContextMenu Opened="TaskbarContextMenu_Opened">
            <MenuItem Header="Open Windows Settings" Click="Settings_Click" />
            <MenuItem Header="Desktop Tuner taskbar settings" Click="ShowSettings_Click" />
            <MenuItem x:Name="AutoHideMenuItem" Header="Automatically hide this taskbar" IsCheckable="True" Click="AutoHideMenuItem_Click" />
            <MenuItem x:Name="AutoHideWhenMaximizedMenuItem" Header="Hide when an app is maximized" IsCheckable="True" Click="AutoHideWhenMaximizedMenuItem_Click" />
            <Separator />
            <MenuItem Header="Close Desktop Tuner taskbar" Click="CloseBar_Click" />
            <MenuItem Header="Exit Desktop Tuner" Click="Quit_Click" />
        </ContextMenu>
    </Window.ContextMenu>
    <Window.Resources>
        <ItemsPanelTemplate x:Key="HorizontalWindowPanel"><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="VerticalWindowPanel"><StackPanel Orientation="Vertical" /></ItemsPanelTemplate>
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource TaskbarPreviewCardBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TaskbarForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TaskbarPreviewBorderBrush}" />
            <Setter Property="local:AcrylicContextMenuBehavior.IsEnabled" Value="True" />
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TaskbarForegroundBrush}" />
            <Setter Property="Padding" Value="{DynamicResource TouchMenuItemPadding}" />
            <Setter Property="MinHeight" Value="{DynamicResource TouchMenuItemMinimumHeight}" />
        </Style>
        <Style x:Key="TaskButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TaskbarForegroundBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="AuraGlow" CornerRadius="8" Background="{Binding AuraBrush}" Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="ButtonBorder" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <Border x:Name="RunningIndicator" Width="16" Height="2" Margin="0,0,0,2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Background="{DynamicResource TaskbarRunningIndicatorBrush}" CornerRadius="1" Visibility="Collapsed" />
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource TaskbarHoverBrush}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource TaskbarPressedBrush}" /></Trigger>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" /></DataTrigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter TargetName="RunningIndicator" Property="Background" Value="{DynamicResource TaskbarAccentBrush}" /></DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding AuraEnabled}" Value="True" />
                                    <Condition Binding="{Binding IsActive}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="RunningIndicator" Property="Background" Value="{Binding AuraSolidBrush}" />
                                <Setter TargetName="AuraGlow" Property="Opacity" Value="0.22" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding AuraEnabled}" Value="True" />
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="ButtonBorder" Property="Background" Value="Transparent" />
                                <Setter TargetName="AuraGlow" Property="Opacity" Value="0.38" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding DynamicAura}" Value="True" />
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="ButtonBorder" Property="Background" Value="Transparent" />
                                <Setter TargetName="AuraGlow" Property="Opacity" Value="0.78" />
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="RootBorder" Background="{DynamicResource TaskbarBackgroundBrush}" BorderBrush="{DynamicResource TaskbarBorderBrush}" BorderThickness="0,1,0,0" Padding="10,4">
        <Grid x:Name="LayoutGrid">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border x:Name="StartSegment" Grid.Column="0">
                <StackPanel x:Name="StartControls" Orientation="Horizontal">
                    <Button x:Name="StartButton" Content="D" Width="38" Height="38" Style="{StaticResource TaskButton}" Background="{DynamicResource TaskbarAccentBrush}" FontWeight="Bold" FontSize="18" Click="Start_Click" ToolTip="Open Desktop Tuner Start menu" />
                    <Button x:Name="SearchButton" Width="38" Height="38" Style="{StaticResource TaskButton}" Click="Search_Click" ToolTip="Open Windows Search (Win+S)" AutomationProperties.Name="Search">
                        <Grid Width="20" Height="20">
                            <Ellipse Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1" Stroke="{DynamicResource TaskbarForegroundBrush}" StrokeThickness="2" />
                            <Line X1="0" Y1="0" X2="7" Y2="7" Stroke="{DynamicResource TaskbarForegroundBrush}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
            <Border x:Name="AppsSegment" Grid.Column="1">
                <Grid>
                    <ScrollViewer x:Name="WindowScroller" Margin="10,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" SizeChanged="WindowScroller_SizeChanged">
                        <StackPanel x:Name="TaskButtonsStack" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="CenterSpacer" Width="0" />
                <ItemsControl x:Name="PinnedItems" VerticalAlignment="Center" ItemsPanel="{StaticResource HorizontalWindowPanel}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource TaskButton}" Margin="{Binding ButtonMargin}" Tag="{Binding Target}" Click="PinnedButton_Click" ToolTip="{Binding ToolTip}" MouseMove="TaskbarAppButton_MouseMove" MouseLeave="TaskbarAppButton_MouseLeave"
                                    AllowDrop="True" PreviewMouseLeftButtonDown="PinnedButton_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="PinnedButton_PreviewMouseLeftButtonUp" PreviewMouseMove="PinnedButton_PreviewMouseMove"
                                    DragOver="PinnedButton_DragOver" DragLeave="PinnedButton_DragLeave" Drop="PinnedButton_Drop">
                                <StackPanel Orientation="Horizontal" MaxWidth="190">
                                    <Grid Width="{Binding IconPixels}" Height="{Binding IconPixels}" VerticalAlignment="Center" Margin="{Binding IconMargin}">
                                        <Image Source="{Binding Icon}" Width="{Binding IconPixels}" Height="{Binding IconPixels}" />
                                        <Border CornerRadius="6" Background="{DynamicResource TaskbarAccentBrush}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Initial}" TextTrimming="CharacterEllipsis" Foreground="White" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding Label}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="130">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers><DataTrigger Binding="{Binding ShowLabel}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Browse folder contents" Tag="{Binding}" IsEnabled="{Binding IsDirectory}" SubmenuOpened="PinnedFolderMenu_SubmenuOpened">
                                            <MenuItem Header="Loading..." IsEnabled="False" />
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Open file location" Tag="{Binding}" IsEnabled="{Binding CanOpenLocation}" Click="OpenPinnedLocation_Click" />
                                        <Separator />
                                        <MenuItem Header="Unpin from taskbar" Tag="{Binding}" Click="Unpin_Click" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border x:Name="PinDivider" Width="1" Height="24" Background="{DynamicResource TaskbarBorderBrush}" Margin="5,0" VerticalAlignment="Center" />
                <ItemsControl x:Name="WindowItems" VerticalAlignment="Center" ItemsPanel="{StaticResource HorizontalWindowPanel}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource TaskButton}" Margin="{Binding ButtonMargin}" Tag="{Binding Target}" Click="WindowButton_Click" PreviewMouseDown="WindowButton_PreviewMouseDown" ToolTip="{Binding ToolTip}" MouseMove="TaskbarAppButton_MouseMove"
                                    MouseEnter="WindowButton_MouseEnter" MouseLeave="WindowButton_MouseLeave"
                                    PreviewMouseLeftButtonDown="WindowButton_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="WindowButton_PreviewMouseLeftButtonUp"
                                    PreviewMouseMove="WindowButton_PreviewMouseMove" DragOver="WindowButton_DragOver" DragLeave="WindowButton_DragLeave" Drop="WindowButton_Drop" AllowDrop="True">
                                <StackPanel Orientation="Horizontal" MaxWidth="190">
                                    <Grid Width="{Binding IconPixels}" Height="{Binding IconPixels}" VerticalAlignment="Center" Margin="{Binding IconMargin}">
                                        <Image Source="{Binding Icon}" Width="{Binding IconPixels}" Height="{Binding IconPixels}">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <Border CornerRadius="4" Background="{DynamicResource TaskbarAccentFallbackBrush}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding Label}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="160">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers><DataTrigger Binding="{Binding ShowLabel}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Minimize window(s)" Tag="{Binding}" Click="Minimize_Click" />
                                        <MenuItem Header="Close window(s)" Tag="{Binding}" Click="CloseWindows_Click" />
                                        <MenuItem Header="Pin app to taskbar" Tag="{Binding}" Click="Pin_Click" />
                                        <MenuItem Header="Close Desktop Tuner bar" Click="CloseBar_Click" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock x:Name="EmptyText" Text="No open app windows" Foreground="{DynamicResource TaskbarEmptyTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="6,0" />
                </Grid>
            </Border>
            <Border x:Name="SystemSegment" Grid.Column="2">
                <StackPanel x:Name="RightControls" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="SettingsButton" Content="Settings" Style="{StaticResource TaskButton}" Click="Settings_Click" FontSize="11" />
                <Button x:Name="TrayButton" Content="Tray" Style="{StaticResource TaskButton}" Click="Tray_Click" FontSize="11" ToolTip="Focus the Windows notification area" />
                <Button x:Name="QuickSettingsButton" Content="Quick" Style="{StaticResource TaskButton}" Click="QuickSettings_Click" FontSize="11" ToolTip="Open Windows Quick Settings (Win+A)" AutomationProperties.Name="Quick Settings" />
                <Button x:Name="NetworkButton" Content="Network" Style="{StaticResource TaskButton}" Click="NetworkSettings_Click" FontSize="11" ToolTip="Open Wi-Fi and network settings" AutomationProperties.Name="Network settings" />
                <Button x:Name="EmojiButton" Content="😊" Style="{StaticResource TaskButton}" Click="Emoji_Click" FontSize="16" Padding="8,4" ToolTip="Open the Windows emoji panel (Win+.)" AutomationProperties.Name="Emoji panel" />
                <Button x:Name="VolumeButton" Content="🔊" Style="{StaticResource TaskButton}" Click="SoundSettings_Click" PreviewMouseDown="VolumeButton_PreviewMouseDown" PreviewMouseWheel="VolumeButton_PreviewMouseWheel" FontSize="16" Padding="8,4" ToolTip="Scroll to adjust volume, middle-click to mute, right-click to choose an output device, click for Sound settings">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="AudioOutputContextMenu" Opened="AudioOutputContextMenu_Opened" />
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="BatteryButton" Visibility="Collapsed" Style="{StaticResource TaskButton}" Click="BatterySettings_Click" Padding="7,4" ToolTip="Battery status" AutomationProperties.Name="Battery status">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="22" Height="14" Margin="0,0,4,0">
                            <Border x:Name="BatteryOutline" Width="17" Height="12" HorizontalAlignment="Left" BorderBrush="{DynamicResource TaskbarForegroundBrush}" BorderThickness="1" CornerRadius="2" Padding="1">
                                <Grid ClipToBounds="True">
                                    <Border x:Name="BatteryFill" Width="0" HorizontalAlignment="Left" Background="{DynamicResource TaskbarAccentBrush}" />
                                    <TextBlock x:Name="BatteryChargingGlyph" Text="⚡" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <Border Width="3" Height="6" HorizontalAlignment="Right" Background="{DynamicResource TaskbarForegroundBrush}" CornerRadius="0,2,2,0" />
                        </Grid>
                        <TextBlock x:Name="BatteryPercentText" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="WidgetsButton" Content="Widgets" Style="{StaticResource TaskButton}" Click="Widgets_Click" FontSize="11" ToolTip="Open the Windows Widgets board" />
                <Button x:Name="TaskViewButton" Width="38" Height="38" Style="{StaticResource TaskButton}" Click="TaskView_Click" ToolTip="Open Windows Task View (Win+Tab)" AutomationProperties.Name="Task View">
                    <Grid Width="20" Height="20">
                        <Border Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1" BorderBrush="{DynamicResource TaskbarForegroundBrush}" BorderThickness="2" CornerRadius="2" />
                        <Border Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1" BorderBrush="{DynamicResource TaskbarForegroundBrush}" BorderThickness="2" CornerRadius="2" Background="{DynamicResource TaskbarBackgroundBrush}" />
                    </Grid>
                </Button>
                <Button x:Name="ShowDesktopButton" Content="Desktop" Style="{StaticResource TaskButton}" Click="ShowDesktop_Click" FontSize="11" ToolTip="Show the desktop (Win+D)" />
                <Button x:Name="ClockButton" Style="{StaticResource TaskButton}" Click="Clock_Click" ToolTip="Open notifications and calendar" Padding="7,4" Margin="3,0,8,0">
                    <Border Background="{DynamicResource TaskbarClockSurfaceBrush}" CornerRadius="8" Padding="10,5">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="ClockText" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="DateText" FontSize="9" Foreground="{DynamicResource TaskbarDateTextBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Button>
                <Button x:Name="CloseBarButton" Content="×" Style="{StaticResource TaskButton}" Click="CloseBar_Click" FontSize="16" ToolTip="Close this taskbar" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
