<Window x:Class="DesktopTuner.TaskbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Tuner Taskbar" Height="54" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" Background="Transparent" AllowsTransparency="True"
        Foreground="#F4F6FA" FontFamily="Segoe UI Variable Text, Segoe UI"
        AllowDrop="True" DragOver="Window_DragOver" DragLeave="Window_DragLeave" Drop="Window_Drop"
        Loaded="Window_Loaded" Closed="Window_Closed" MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave">
    <Window.Resources>
        <ItemsPanelTemplate x:Key="HorizontalWindowPanel"><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="VerticalWindowPanel"><StackPanel Orientation="Vertical" /></ItemsPanelTemplate>
        <Style x:Key="TaskButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E5E9F2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#30394D" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#494F70" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="RootBorder" Background="#F2171D2A" BorderBrush="#405064" BorderThickness="0,1,0,0" Padding="10,4">
        <Grid x:Name="LayoutGrid">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border x:Name="StartSegment" Grid.Column="0">
                <Button x:Name="StartButton" Content="D" Width="38" Height="38" Style="{StaticResource TaskButton}" Background="#6258D9" FontWeight="Bold" FontSize="18" Click="Start_Click" ToolTip="Open Desktop Tuner Start menu" />
            </Border>
            <Border x:Name="AppsSegment" Grid.Column="1">
                <Grid>
                    <ScrollViewer x:Name="WindowScroller" Margin="10,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="TaskButtonsStack" Orientation="Horizontal" VerticalAlignment="Center">
                <ItemsControl x:Name="PinnedItems" VerticalAlignment="Center" ItemsPanel="{StaticResource HorizontalWindowPanel}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource TaskButton}" Tag="{Binding}" Click="PinnedButton_Click" ToolTip="{Binding ExecutablePath}"
                                    AllowDrop="True" DragOver="PinnedButton_DragOver" DragLeave="PinnedButton_DragLeave" Drop="PinnedButton_Drop">
                                <StackPanel Orientation="Horizontal" MaxWidth="190">
                                    <Border Width="20" Height="20" CornerRadius="6" Background="#6258D9" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Name}" MaxWidth="17" TextTrimming="CharacterEllipsis" Foreground="White" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="130" />
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Unpin from taskbar" Tag="{Binding}" Click="Unpin_Click" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border x:Name="PinDivider" Width="1" Height="24" Background="#405064" Margin="5,0" VerticalAlignment="Center" />
                <ItemsControl x:Name="WindowItems" VerticalAlignment="Center" ItemsPanel="{StaticResource HorizontalWindowPanel}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource TaskButton}" Tag="{Binding}" Click="WindowButton_Click" ToolTip="{Binding ToolTip}">
                                <StackPanel Orientation="Horizontal" MaxWidth="190">
                                    <Border Width="7" Height="7" CornerRadius="4" Background="#8D86FF" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Label}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="160" />
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Minimize window(s)" Tag="{Binding}" Click="Minimize_Click" />
                                        <MenuItem Header="Pin app to taskbar" Tag="{Binding}" Click="Pin_Click" />
                                        <MenuItem Header="Close Desktop Tuner bar" Click="CloseBar_Click" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock x:Name="EmptyText" Text="No open app windows" Foreground="#8993A7" FontSize="11" VerticalAlignment="Center" Margin="6,0" />
                </Grid>
            </Border>
            <Border x:Name="SystemSegment" Grid.Column="2">
                <StackPanel x:Name="RightControls" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Settings" Style="{StaticResource TaskButton}" Click="Settings_Click" FontSize="11" />
                <Border Background="#30394D" CornerRadius="8" Padding="10,6" Margin="3,0,8,0">
                    <TextBlock x:Name="ClockText" FontSize="12" FontWeight="SemiBold" />
                </Border>
                <Button Content="×" Style="{StaticResource TaskButton}" Click="CloseBar_Click" FontSize="16" ToolTip="Close this taskbar" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
