<Window x:Class="DesktopTuner.TaskbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Tuner Taskbar" Height="54" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" Background="#171D2A"
        Foreground="#F4F6FA" FontFamily="Segoe UI Variable Text, Segoe UI"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Window.Resources>
        <Style x:Key="TaskButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E5E9F2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#30394D" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#494F70" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="#F2171D2A" BorderBrush="#405064" BorderThickness="0,1,0,0" Padding="10,4">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="D" Width="38" Height="38" Style="{StaticResource TaskButton}" Background="#6258D9" FontWeight="Bold" FontSize="18" Click="Start_Click" ToolTip="Open Desktop Tuner Start menu" />
            <Grid Grid.Column="1" Margin="10,0">
                <ItemsControl x:Name="WindowItems" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource TaskButton}" Tag="{Binding}" Click="WindowButton_Click" ToolTip="{Binding Title}">
                                <StackPanel Orientation="Horizontal" MaxWidth="190">
                                    <Border Width="7" Height="7" CornerRadius="4" Background="#8D86FF" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="160" />
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Minimize" Tag="{Binding}" Click="Minimize_Click" />
                                        <MenuItem Header="Close Desktop Tuner bar" Click="CloseBar_Click" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="EmptyText" Text="No open app windows" Foreground="#8993A7" FontSize="11" VerticalAlignment="Center" Margin="6,0" />
            </Grid>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Settings" Style="{StaticResource TaskButton}" Click="Settings_Click" FontSize="11" />
                <Border Background="#30394D" CornerRadius="8" Padding="10,6" Margin="3,0,8,0">
                    <TextBlock x:Name="ClockText" FontSize="12" FontWeight="SemiBold" />
                </Border>
                <Button Content="×" Style="{StaticResource TaskButton}" Click="CloseBar_Click" FontSize="16" ToolTip="Close this taskbar" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
