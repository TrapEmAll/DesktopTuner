<Window x:Class="DesktopTuner.DesktopHostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Tuner Desktop Host (prototype)" WindowStyle="None" ResizeMode="NoResize"
        WindowState="Maximized" ShowInTaskbar="False" ShowActivated="False" Background="#273044"
        KeyDown="OnKeyDown" Loaded="OnLoaded">
    <Grid AllowDrop="True" DragOver="OnDesktopDragOver" Drop="OnDesktopDrop">
        <ItemsControl x:Name="DesktopItems" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel Orientation="Vertical" MaxHeight="850"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Width="92" Height="104" Margin="4" Padding="6" BorderThickness="0" AllowDrop="True"
                            Background="Transparent" Foreground="White" ToolTip="Double-click to open"
                            PreviewMouseLeftButtonDown="OnItemMouseDown" PreviewMouseMove="OnItemMouseMove"
                            DragOver="OnItemDragOver" Drop="OnItemDrop" MouseDoubleClick="OnItemDoubleClick">
                        <Button.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="Open" Click="OnOpenItemClick"/>
                                <MenuItem Header="Show more options" IsEnabled="{Binding CanShowNativeContextMenu}"
                                          Click="OnShowNativeContextMenuClick"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image Width="40" Height="40" Source="{Binding Icon}" Stretch="Uniform"/>
                            <TextBlock Margin="0,6,0,0" Text="{Binding Name}" TextAlignment="Center"
                                       TextWrapping="Wrap" MaxHeight="38" Foreground="White"
                                       Effect="{DynamicResource DesktopHostTextShadow}"/>
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Padding="10,6"
                Background="#B0202020" CornerRadius="6" IsHitTestVisible="False">
            <TextBlock Text="Desktop host prototype · F5 to refresh" Foreground="White"/>
        </Border>
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Refresh" Click="OnRefreshClick"/>
                <MenuItem Header="New folder" Click="OnNewFolderClick"/>
                <Separator/>
                <MenuItem Header="Open Desktop folder" Click="OnOpenDesktopFolderClick"/>
                <Separator/>
                <MenuItem Header="Exit desktop host" Click="OnExitClick"/>
            </ContextMenu>
        </Grid.ContextMenu>
    </Grid>
</Window>
