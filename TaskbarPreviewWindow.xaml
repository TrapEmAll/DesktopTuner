<Window x:Class="DesktopTuner.TaskbarPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="760" Height="232" MinWidth="250" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" Background="#171D2A" Foreground="#F4F6FA"
        FontFamily="Segoe UI Variable Text, Segoe UI" Loaded="Window_Loaded" Closed="Window_Closed"
        Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="#F2171D2A" BorderBrush="#66708D" BorderThickness="1" CornerRadius="12" Padding="10">
        <ScrollViewer x:Name="CardsScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" ScrollChanged="CardsScroller_ScrollChanged">
            <StackPanel x:Name="CardsPanel" Orientation="Horizontal" />
        </ScrollViewer>
    </Border>
</Window>
